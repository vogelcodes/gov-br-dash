{
  "name": "gov-br-dash",
  "version": "0.0.1",
  "description": "Serviço web para acesso a dados públicos do gov.br",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run web:build && tsx watch src/server.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:typecheck": "tsc --noEmit -p web/tsconfig.json",
    "build": "npm run web:build && tsc",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "typecheck": "tsc --noEmit && npm run web:typecheck",
    "format": "prettier --write src/ tests/",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix",
    "verify": "npm run typecheck && npm run lint && npm test && npm run security:audit",
    "prepare": "husky install"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.3",
    "axios": "^1.6.7",
    "better-sqlite3": "^12.9.0",
    "csv-stringify": "^6.7.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.8.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/router-vite-plugin": "^1.166.50",
    "@types/better-sqlite3": "^7.6.13",
    "@types/eslint": "^8.56.2",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.0",
    "postcss": "^8.5.14",
    "prettier": "^3.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix",
      "vitest related --run"
    ]
  },
  "keywords": [
    "gov.br",
    "api",
    "brasil",
    "dados-publicos"
  ],
  "author": "",
  "license": "MIT"
}

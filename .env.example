NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# API gov.br
GOVBR_API_BASE_URL=https://api.portaldatransparencia.gov.br
GOVBR_API_KEY=replace-with-your-portal-transparencia-api-key
GOVBR_API_TIMEOUT_MS=5000

# API Compras.gov.br Dados Abertos
COMPRAS_GOV_API_BASE_URL=https://dadosabertos.compras.gov.br
COMPRAS_GOV_API_TIMEOUT_MS=30000
COMPRAS_GOV_MAX_RETRIES=3
COMPRAS_GOV_RETRY_DELAY_MS=500

# Persistência e sessões
SQLITE_DB_PATH=data/app.sqlite
SESSION_COOKIE_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=2592000

# Cache
CACHE_DEFAULT_TTL_SECONDS=60
UASG_CACHE_TTL_SECONDS=86400
CACHE_STALE_TTL_SECONDS=120
CACHE_MAX_ENTRIES=10000

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60

# CORS
CORS_ORIGIN=*

# Redis (futuro)
# REDIS_URL=redis://localhost:6379
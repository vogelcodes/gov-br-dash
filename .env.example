NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# API gov.br
GOVBR_API_BASE_URL=https://api.portaldatransparencia.gov.br
GOVBR_API_KEY=replace-with-your-portal-transparencia-api-key
GOVBR_API_TIMEOUT_MS=5000

# API Compras.gov.br Dados Abertos
COMPRAS_GOV_API_BASE_URL=https://dadosabertos.compras.gov.br
COMPRAS_GOV_API_TIMEOUT_MS=30000

# Cache
CACHE_DEFAULT_TTL_SECONDS=60
CACHE_STALE_TTL_SECONDS=120
CACHE_MAX_ENTRIES=10000

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60

# CORS
CORS_ORIGIN=*

# Redis (futuro)
# REDIS_URL=redis://localhost:6379

# SQLite persistence (auth, sessions, user data)
SQLITE_DB_PATH=data/app.sqlite

# Cookie signing secret (min 32 chars; generate with: openssl rand -hex 32)
COOKIE_SECRET=replace-with-32-char-minimum-secret